{
  "$comment": "Q3/OA trap_ syscall -> meep facility classification. prefixRules apply in order; entries override. status: mapped | ported | workaround | gap | not-needed",
  "prefixRules": [
    {
      "prefix": "trap_AAS_",
      "status": "not-needed",
      "meep": "own waypoint graph (not meep NavigationMesh)",
      "note": "AAS deleted wholesale, per the brief. Navigation is a floor-sampled waypoint graph rather than meep NavigationMesh, whose builder needs a manifold surface that Q3 geometry does not provide -- measured at 5% spawn-pair routability from brushes and 0% from render surfaces (GAP-016). None of these individual AAS queries is answered by anything."
    },
    {
      "prefix": "trap_Bot",
      "status": "not-needed",
      "meep": "meep behaviour trees + blackboard",
      "note": "botlib deleted; anti-goal in brief section 10. Bots run meep behaviour trees (SelectorBehavior / SequenceBehavior / ConditionBehavior) over a three-branch tree."
    },
    {
      "prefix": "trap_EA_",
      "status": "not-needed",
      "meep": "bot writes usercmd_t directly",
      "note": "Elementary Action layer is a botlib IPC shim; an in-process bot just fills a usercmd_t."
    },
    {
      "prefix": "trap_Characteristic_",
      "status": "not-needed",
      "meep": "behaviour-tree blackboard",
      "note": "Bot personality files not ported."
    },
    {
      "prefix": "trap_LAN_",
      "status": "not-needed",
      "meep": "-",
      "note": "Server browser. Single process, no netcode."
    },
    {
      "prefix": "trap_CIN_",
      "status": "not-needed",
      "meep": "-",
      "note": "RoQ cinematic playback. Cut."
    },
    {
      "prefix": "trap_Rank",
      "status": "not-needed",
      "meep": "-",
      "note": "Q3 online rankings service, dead since 2002."
    },
    {
      "prefix": "trap_CL_UI_Rank",
      "status": "not-needed",
      "meep": "-",
      "note": "As above."
    }
  ],
